{
  "name": "code-factory-web",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --build tsconfig.ts7.json && vue-tsc --build",
    "lint": "eslint . --max-warnings 0",
    "unused": "knip",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --coverage --project unit",
    "test:component": "vitest run --project component",
    "e2e": "playwright test",
    "demo": "playwright test --config playwright.demo.config.ts",
    "perf": "playwright test --config playwright.perf.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.4.0",
    "@hugeicons/vue": "^1.0.8",
    "@internationalized/date": "^3.12.4",
    "@tanstack/vue-query": "^5.107.1",
    "@tanstack/vue-table": "^9.3.1",
    "@unovis/ts": "^1.8.0",
    "@unovis/vue": "^1.8.0",
    "@vueuse/core": "15.0.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "fuse.js": "7.5.0",
    "reka-ui": "^2.11.0",
    "shiki": "^4.6.0",
    "sortablejs": "1.15.7",
    "tw-animate-css": "^1.4.0",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "vue-sonner": "^2.0.9"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/sortablejs": "1.15.9",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "5.0.5",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.13.0",
    "eslint-plugin-playwright": "2.12.1",
    "eslint-plugin-vue": "^10.11.1",
    "eslint-plugin-vuejs-accessibility": "^2.6.2",
    "happy-dom": "21.0.4",
    "jiti": "^2.7.0",
    "knip": "6.42.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript7": "npm:typescript@7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  }
}

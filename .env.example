# Template for .env.local (gitignored). Copy it there and uncomment what you change; every line
# shows its default. Files are read from the working directory, lowest priority first: .env,
# .env.$CODE_FACTORY_ENV, .env.local; the process environment beats all of them.
# CODE_FACTORY_ENV selects the middle layer and is read from the process environment only.

# postgresql+asyncpg:// URL of the database. Required. The password shown is a placeholder: the
# keychain is its default home, so put the real URL in .env.local or export it from the keychain.
CODE_FACTORY_DATABASE_URL=postgresql+asyncpg://code_factory:change-me@127.0.0.1:5432/code_factory

# Address the server binds.
# CODE_FACTORY_HOST=127.0.0.1

# Port the server binds; 0 takes a free one and prints it.
# CODE_FACTORY_PORT=4000

# DEBUG, INFO, WARNING, ERROR or CRITICAL.
# CODE_FACTORY_LOG_LEVEL=INFO

# Whether `serve` opens the browser signed in (on a terminal only); false, 0, no or off disables it.
# CODE_FACTORY_OPEN=True

# Schema every table lives in.
# CODE_FACTORY_DB_SCHEMA=public

# Connections kept in the pool.
# CODE_FACTORY_DB_POOL_SIZE=10

# Connections allowed beyond the pool.
# CODE_FACTORY_DB_MAX_OVERFLOW=5

# Seconds to wait for a pooled connection.
# CODE_FACTORY_DB_POOL_TIMEOUT_S=10.0

# Seconds after which a connection is replaced.
# CODE_FACTORY_DB_POOL_RECYCLE_S=1800

# Seconds /api/ready waits for the database.
# CODE_FACTORY_READY_TIMEOUT_S=2.0

# Seconds the startup schema check waits before reporting the database busy.
# CODE_FACTORY_SCHEMA_CHECK_TIMEOUT_S=5.0

# Seconds the server waits for open requests on shutdown.
# CODE_FACTORY_SHUTDOWN_TIMEOUT_S=10

# Absolute folder for what is not in the database: run logs, the session spool, check logs and
# caches. The default is ~/.local/state/code-factory.
# CODE_FACTORY_STATE_DIR=

# Absolute folder of the unpacked releases a deploy switches between. The default is
# ~/.local/share/code-factory/releases.
# CODE_FACTORY_RELEASES_DIR=

# Absolute folder for a served board's sockets and log. The default is $XDG_RUNTIME_DIR/code-factory
# (code-factory-<uid> in $TMPDIR when XDG_RUNTIME_DIR is unset).
# CODE_FACTORY_RUN_DIR=

# End the served board when its standard input closes.
# CODE_FACTORY_STOP_AT_EOF=False

# Seconds a key broker call to a provider may take.
# CODE_FACTORY_BROKER_CALL_TIMEOUT_S=15.0

# Seconds between sweeps of the broker's run keys.
# CODE_FACTORY_BROKER_SWEEP_INTERVAL_S=30.0

# Seconds the broker waits for a provider's answer to stream.
# CODE_FACTORY_BROKER_READ_TIMEOUT_S=600.0

# Largest request body the broker forwards, in MiB.
# CODE_FACTORY_BROKER_MAX_BODY_MIB=32
